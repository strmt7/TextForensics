{"$id":"https://github.com/strmt7/TextForensics/schemas/mixed-origin-report.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"U4 mixed-origin / co-authorship report: per-segment (sentence) evidence, HART collaboration type, degree-of-change tiers, operation hypothesis, and the verdict — withheld whenever the evidence is mixed or the input regime has no mixed-origin validation slice. Segments are identified by SHA-256 hash plus char offsets; the report never contains raw input text. Segment scores are evidence scores, never sentence authorship probabilities.","properties":{"collaboration_confidence":{"enum":["low","medium","high"]},"collaboration_type":{"enum":["HH","HA","AH","AA","unknown"]},"degree_of_change":{"additionalProperties":false,"properties":{"calibration":{"minLength":1,"type":"string"},"estimate":{"maximum":1,"minimum":0,"type":["number","null"]},"method":{"minLength":1,"type":"string"},"tiers":{"enum":["human","lightly","moderately","ai",null]}},"required":["estimate","tiers","method","calibration"],"type":"object"},"detector":{"additionalProperties":false,"properties":{"id":{"minLength":1,"type":"string"},"version":{"minLength":1,"type":"string"}},"required":["id","version"],"type":"object"},"idea_provenance_note":{"const":"Prose evidence cannot determine who originated the ideas (IdeaLens 2026)."},"input":{"additionalProperties":false,"properties":{"char_count":{"minimum":0,"type":"integer"},"content_hash":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"segment_count":{"minimum":0,"type":"integer"},"word_count":{"minimum":0,"type":"integer"}},"required":["content_hash","char_count","word_count","segment_count"],"type":"object"},"limitations":{"items":{"type":"string"},"minItems":1,"type":"array"},"non_monotonicity_warning":{"const":"Intermediate mixtures are the hardest regime to detect (OpAI-Bench 2026); a low AI score here does not mean human."},"operation_hypothesis":{"additionalProperties":false,"properties":{"confidence":{"enum":["low","medium","high"]},"direction":{"enum":["human→ai","ai→human","unknown"]},"evidence":{"items":{"type":"string"},"type":"array"},"operation":{"enum":["polish","expand","condense","rewrite","humanise","unknown"]}},"required":["operation","direction","confidence","evidence"],"type":"object"},"regime":{"additionalProperties":false,"properties":{"domain":{"type":["string","null"]},"language":{"type":["string","null"]},"validation_slice_covered":{"type":"boolean"}},"required":["language","domain","validation_slice_covered"],"type":"object"},"schema":{"const":"textforensics.mixed-origin-report/v1"},"segments":{"items":{"additionalProperties":false,"properties":{"evidence":{"enum":["ai-consistent","human-consistent","insufficient"]},"methods_agreeing":{"items":{"enum":["structural_uniformity","formulaic_language","lexical_profile"]},"type":"array"},"n_words":{"minimum":0,"type":"integer"},"score":{"maximum":1,"minimum":0,"type":"number"},"score_meaning":{"const":"segment evidence score, NOT a sentence authorship probability"},"span":{"maxItems":2,"minItems":2,"prefixItems":[{"minimum":0,"type":"integer"},{"minimum":0,"type":"integer"}],"type":"array"},"text_hash":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"}},"required":["span","text_hash","evidence","score","score_meaning","methods_agreeing","n_words"],"type":"object"},"type":"array"},"verdict":{"enum":["withheld","mixed","human","ai"]},"withheld_reasons":{"items":{"type":"string"},"type":"array"}},"required":["schema","input","detector","verdict","withheld_reasons","collaboration_type","collaboration_confidence","degree_of_change","operation_hypothesis","segments","non_monotonicity_warning","idea_provenance_note","regime","limitations"],"title":"TextForensics mixed-origin report","type":"object"}
