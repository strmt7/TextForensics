{"$id":"https://github.com/strmt7/TextForensics/schemas/probe-run.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"One U3 drift-observatory probe run over the frozen probe corpus: corpus fingerprint, detector/provider metadata, per-slice and overall §7.6 metrics, three-tier persistence-gated alerts, demotions applied/cleared, watches, and gap declarations. Run manifests cite probe items by ID and hash only; they never contain raw probe text.","properties":{"alerts":{"items":{"additionalProperties":true,"properties":{"action":{"enum":["demote","investigate","record"]},"detail":{"minLength":1,"type":"string"},"rule":{"minLength":1,"type":"string"},"slice":{"minLength":1,"type":"string"},"tier":{"enum":[1,2,3]}},"required":["tier","rule","slice","action","detail"],"type":"object"},"type":"array"},"alpha_per_run":{"exclusiveMinimum":0,"maximum":1,"type":"number"},"baseline_run_id":{"type":["string","null"]},"breaches":{"items":{"type":"object"},"type":"array"},"code_sha":{"minLength":1,"type":"string"},"corpus_fingerprint":{"pattern":"^[0-9a-f]{64}$","type":"string"},"corpus_manifest_sha256":{"pattern":"^[0-9a-f]{64}$","type":["string","null"]},"corpus_version":{"minLength":1,"type":"string"},"demotions_applied":{"type":"object"},"demotions_cleared":{"type":"object"},"detector_id":{"minLength":1,"type":"string"},"detector_version":{"minLength":1,"type":"string"},"gaps":{"items":{"type":"string"},"type":"array"},"is_baseline":{"type":"boolean"},"limitations":{"items":{"type":"string"},"type":"array"},"metrics":{"type":"object"},"previous_run_id":{"type":["string","null"]},"provider_metadata":{"type":"object"},"rebaselined_from":{"type":["string","null"]},"run_at_utc":{"minLength":1,"type":"string"},"run_id":{"minLength":1,"type":"string"},"schema":{"const":"textforensics.probe-run/v1"},"scope":{"enum":["full","monthly-attacked","monthly-current-generator","event-driven"]},"scope_statement":{"minLength":1,"t