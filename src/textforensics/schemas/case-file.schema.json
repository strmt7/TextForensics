{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/strmt7/TextForensics/schemas/case-file.schema.json",
  "title": "TextForensics Case File",
  "type": "object",
  "required": [
    "schema",
    "tool",
    "forensic_bundle",
    "raw_text_included",
    "case_sha256"
  ],
  "properties": {
    "schema": {
      "enum": [
        "textforensics.case-file/v1",
        "textforensics.case-file/v2"
      ]
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "TextForensics"},
        "version": {"type": "string", "minLength": 1},
        "git_sha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{7,40}$"
        }
      },
      "additionalProperties": false
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "forensic_bundle": {"type": "object"},
    "raw_text_included": {"const": false},
    "manifest": {
      "type": "object",
      "required": [
        "content_sha256",
        "registry_id",
        "registry_sha256",
        "calibration_ids",
        "schema_versions",
        "git_sha"
      ],
      "properties": {
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "registry_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "registry_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "calibration_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "schema_versions": {"type": "object"},
        "git_sha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{7,40}$"
        }
      },
      "additionalProperties": false
    },
    "case_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"schema": {"const": "textforensics.case-file/v2"}},
        "required": ["schema"]
      },
      "then": {
        "required": ["created_at_utc", "manifest"],
        "properties": {
          "tool": {
            "required": ["git_sha"]
          }
        }
      }
    }
  ]
}
