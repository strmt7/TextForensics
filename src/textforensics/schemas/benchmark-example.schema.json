{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/strmt7/TextForensics/schemas/benchmark-example.schema.json",
  "title": "TextForensics Normalized Benchmark Example v1",
  "type": "object",
  "required": [
    "schema",
    "sample_id",
    "label",
    "text",
    "dataset",
    "dataset_revision",
    "split",
    "metadata"
  ],
  "properties": {
    "schema": {"const": "textforensics.benchmark-example/v1"},
    "sample_id": {"type": "string", "minLength": 1},
    "label": {"enum": ["human", "ai"]},
    "text": {"type": "string", "minLength": 1},
    "dataset": {"type": "string", "minLength": 1},
    "dataset_revision": {"type": "string", "minLength": 1},
    "split": {"type": "string", "minLength": 1},
    "source_id": {"type": ["string", "null"]},
    "language": {"type": ["string", "null"]},
    "domain": {"type": ["string", "null"]},
    "generator": {"type": ["string", "null"]},
    "transformation": {"type": ["string", "null"]},
    "source_file_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
