{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":dependencyDashboard",
    ":disableRateLimiting",
    "schedule:weekly",
    "group:devDependencies",
    "group:securityUpdates"
  ],
  "schedule": [
    "every Monday at 09:00 UTC"
  ],
  "timezone": "UTC",
  "prCreation": "not-pending",
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "matchDatasources": ["pypi"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "requiredStatusChecks": ["CI", "Core Python 3.11", "Core Python 3.12", "Core Python 3.13", "Core Python 3.14", "Core Python 3.15", "OS smoke ubuntu-latest Python 3.11", "OS smoke ubuntu-latest Python 3.15", "Build and wheel-install", "Optional API surface Python 3.11", "Optional API surface Python 3.15", "Optional MCP surface Python 3.11", "Optional MCP surface Python 3.15"],
      "labels": ["dependencies", "automerge"]
    },
    {
      "matchUpdateTypes": ["major"],
      "matchDatasources": ["pypi"],
      "automerge": false,
      "labels": ["dependencies", "major-update", "needs-review"],
      "reviewers": ["strmt7"]
    },
    {
      "matchDatasources": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "requiredStatusChecks": ["CI", "Core Python 3.11", "Core Python 3.12", "Core Python 3.13", "Core Python 3.14", "Core Python 3.15", "OS smoke ubuntu-latest Python 3.11", "OS smoke ubuntu-latest Python 3.15", "Build and wheel-install", "Optional API surface Python 3.11", "Optional API surface Python 3.15", "Optional MCP surface Python 3.11", "Optional MCP surface Python 3.15"],
      "labels": ["dependencies", "github-actions", "automerge"]
    },
    {
      "matchDatasources": ["docker"],
      "automerge": false,
      "labels": ["dependencies", "docker", "needs-review"]
    },
    {
      "matchPackagePatterns": ["^bandit$", "^pip-audit$"],
      "matchDatasources": ["pypi"],
      "schedule": ["after 9am on Monday"],
      "labels": ["dependencies", "security-tools"]
    },
    {
      "matchPackagePatterns": ["^ruff$", "^pytest$", "^pytest-cov$", "^pytest-benchmark$", "^coverage$", "^build$", "^twine$", "^httpx$", "^jsonschema$"],
      "matchDatasources": ["pypi"],
      "groupName": "dev-dependencies",
      "labels": ["dependencies", "dev-dependencies"]
    },
    {
      "matchPackagePatterns": ["^fastapi$", "^uvicorn$", "^mcp$", "^rich$"],
      "matchDatasources": ["pypi"],
      "groupName": "optional-dependencies",
      "labels": ["dependencies", "optional-dependencies"]
    }
  ],
  "ignoreDeps": [],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "vulnerability", "high-priority"],
    "createIssue": false,
    "branchPrefix": "security/",
    "minimumSeverity": "moderate",
    "groupName": "security-updates"
  },
  "licensePolicy": {
    "ignore": ["AGPL-3.0", "AGPL-3.0-or-later"],
    "allowed": [
      "MIT",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "Apache-2.0",
      "ISC",
      "Python-2.0",
      "PSF-2.0",
      "MPL-2.0",
      "LGPL-2.1",
      "LGPL-3.0"
    ]
  },
  "postUpdateOptions": [
    "gpgSign"
  ],
  "commitMessagePrefix": "deps:",
  "commitMessageTopic": "{{depName}}",
  "commitMessageAction": "update",
  "commitMessageExtra": "to {{newVersion}}",
  "prTitle": "deps: update {{depName}} to {{newVersion}}",
  "prBodyTemplate": "{{{header}}}\n\n{{{changelog}}}\n\n{{{commits}}}\n\n---\n\nThis PR was generated by [Renovate Bot](https://github.com/renovatebot/renovate).",
  "rebaseWhen": "behind-base-branch",
  "ignoreUnstable": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["every Monday at 09:00 UTC"],
    "automerge": true,
    "labels": ["dependencies", "lockfile"]
  }
}
